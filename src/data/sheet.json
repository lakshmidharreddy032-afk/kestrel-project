    { "key": "totalDebits", "label": "Total Bank Debits (6 Months)", "formula": "Sum of operational withdrawals", "source": "Bank Statement" },
    { "key": "avgMonthlyBalance", "label": "Average Monthly Balance (AMB)", "formula": "Sum of month-end balances ÷ 6", "source": "Bank Statement" },
